# ── Required ──────────────────────────────────────────────────────────────────
# Twitch application credentials.  Create an application at
# https://dev.twitch.tv/console/apps and copy its Client ID and Client Secret
# here.  Set the application's OAuth redirect URL to:
#   http://localhost:4343/oauth/callback
#
# These two values are ALL you need.  On the first start the bot has no
# account tokens yet, so it launches a small one-time authorization server on
# port 4343 and prints a URL (http://localhost:4343/oauth) in its log.  Open
# that URL once in a browser, sign in with the bot account, and approve the
# app.  The bot saves the resulting tokens under the data directory (see
# VOXER_TOKEN_FILE below), refreshes them automatically, and never asks
# again — they survive restarts.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Optional: seed tokens (manual override) ───────────────────────────────────
# Normally leave these empty — the first-run browser flow above obtains tokens
# for you.  Fill them in only if you already have a valid access/refresh token
# pair (for example, generated with an external tool) and want to skip the
# browser step; they are used once to seed the token file.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# ── Optional: bot identity ────────────────────────────────────────────────────
# Twitch login name of the bot account (default: worxbend)
TWITCH_BOT_USERNAME=worxbend

# ── Optional: OAuth callback server ───────────────────────────────────────────
# Address the one-time authorization server listens on (default: localhost).
# In Docker this must be 0.0.0.0 so the published port can reach it —
# docker-compose.yml already sets that.
VOXER_OAUTH_HOST=localhost
# Port for the authorization server (default: 4343).  Must match the port in
# the redirect URL registered in the Twitch dev console.
VOXER_OAUTH_PORT=4343
# The full OAuth Redirect URL — must match exactly what is registered as an
# "OAuth Redirect URL" in the Twitch dev console.
# Default: http://localhost:<VOXER_OAUTH_PORT>/oauth/callback
# A non-localhost host MUST use https:// (Twitch only allows plain http for
# localhost, and startup validation rejects it).  Override for a
# reverse-proxy setup, e.g.:
#VOXER_OAUTH_REDIRECT_URL=https://bot.example.org/oauth/callback
# Where the obtained OAuth tokens are stored (default: data/tokens.json)
VOXER_TOKEN_FILE=data/tokens.json

# ── Optional: paths ───────────────────────────────────────────────────────────
# JSON file storing username → voice assignments (default: data/voices.json)
VOXER_DB_PATH=data/voices.json

# JSON file storing username → last-message timestamps (default: data/timestamps.json)
VOXER_TIMESTAMPS_DB_PATH=data/timestamps.json

# Directory for generated MP3 files served to the overlay (default: audio)
VOXER_AUDIO_DIR=audio

# JSON file of scheduled chat messages (default: data/messages.json)
VOXER_MESSAGES_PATH=data/messages.json

# Directory of custom voice JSON files (default: voices)
VOXER_VOICES_DIR=voices

# pickledb file written by voxer/fetch_emotes.py (default: emotes/emotes.db)
VOXER_EMOTES_DB_PATH=emotes/emotes.db

# ── Optional: server ──────────────────────────────────────────────────────────
VOXER_SERVER_HOST=0.0.0.0
VOXER_SERVER_PORT=8080

# ── Optional: scheduler ───────────────────────────────────────────────────────
# Seconds to wait before re-checking when the scheduled-message list is empty
# or invalid (default: 600).  This is NOT the posting cadence — that is derived
# from each message's frequency_per_hour in data/messages.json.
# (VOXER_SCHEDULER_INTERVAL is accepted as a deprecated alias.)
VOXER_SCHEDULER_EMPTY_RETRY_DELAY=600
# Seconds to wait before first scheduled message after startup (default: 10)
VOXER_SCHEDULER_INITIAL_DELAY=10

# ── Optional: TTS behaviour ───────────────────────────────────────────────────
# Comma-separated list of usernames that never receive the "X says:" prefix
VOXER_NO_ANNOUNCE_USERS=worxbend

# Seconds of silence before re-announcing a user's name (default: 300 = 5 min)
VOXER_ANNOUNCE_WINDOW_SECS=300

# Comma-separated MP3 paths played for emote-only messages
VOXER_EMOTE_SOUND_PATHS=emotes/slack-message.mp3,emotes/discord.mp3

# How many messages may wait for speech synthesis at once (default: 20).
# Synthesis takes seconds per message, so without a limit a busy chat would
# push the overlay minutes behind live chat. When the queue is full, new chat
# messages are dropped; channel events (follows, subs, raids) wait instead.
# Raise it to lose fewer messages during bursts, lower it to stay closer to live.
VOXER_MESSAGE_QUEUE_MAXSIZE=20

# ── Optional: logging ─────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
VOXER_LOG_LEVEL=INFO
