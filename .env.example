# ── Required ──────────────────────────────────────────────────────────────────
# Twitch application credentials.  Create an application at
# https://dev.twitch.tv/console/apps and copy its Client ID and Client Secret
# here.  Set the application's OAuth redirect URL to:
#   http://localhost:4343/oauth/callback
#
# These three values are ALL you need.  On the first start the bot has no
# account tokens yet, so it launches a small one-time authorization server on
# port 4343 and prints a URL (http://localhost:4343/oauth) in its log.  Open
# that URL in a browser, sign in with your channel account, and approve the
# app.  The bot saves the resulting tokens under the data directory (see
# VOXER_TOKEN_FILE below) and refreshes them automatically across restarts.
# If access is revoked, authorize the account again.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Required — your channel account's lowercase Twitch login, exactly as it
# appears in twitch.tv/<this>. Authorize this same account in the browser.
# This account also selects the channel Voxer reads; a separate bot account
# would select that bot's own channel. Messages from this account are skipped.
TWITCH_BOT_USERNAME=

# ── Optional: seed tokens (manual override) ───────────────────────────────────
# Normally leave these empty — the first-run browser flow above obtains tokens
# for you.  Fill them in only if you already have a valid access/refresh token
# pair (for example, generated with an external tool) and want to skip the
# browser step; they are used once to seed the token file.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# ── Optional: OAuth callback server ───────────────────────────────────────────
# Address the one-time authorization server listens on (default: localhost).
# In Docker this must be 0.0.0.0 so the published port can reach it —
# docker-compose.yml already sets that.
VOXER_OAUTH_HOST=localhost
# Port for the authorization server (default: 4343).  Must match the port in
# the redirect URL registered in the Twitch dev console.
VOXER_OAUTH_PORT=4343
# The full OAuth Redirect URL — must match exactly what is registered as an
# "OAuth Redirect URL" in the Twitch dev console.
# Default: http://localhost:<VOXER_OAUTH_PORT>/oauth/callback
# A non-localhost host MUST use https:// (Twitch only allows plain http for
# localhost, and startup validation rejects it).  Override for a
# reverse-proxy setup, e.g.:
#VOXER_OAUTH_REDIRECT_URL=https://bot.example.org/oauth/callback
# Where the obtained OAuth tokens are stored (default: data/tokens.json)
VOXER_TOKEN_FILE=data/tokens.json

# ── Optional: paths ───────────────────────────────────────────────────────────
# JSON file storing username → voice assignments (default: data/voices.json)
VOXER_DB_PATH=data/voices.json

# JSON file storing username → last-message timestamps (default: data/timestamps.json)
VOXER_TIMESTAMPS_DB_PATH=data/timestamps.json

# Directory for generated MP3 files served to the overlay (default: audio)
VOXER_AUDIO_DIR=audio

# JSON file of scheduled chat messages (default: data/messages.json)
VOXER_MESSAGES_PATH=data/messages.json

# Directory of custom voice JSON files (default: voices)
VOXER_VOICES_DIR=voices

# JSON file written by voxer/fetch_emotes.py (default: emotes/emotes.db)
VOXER_EMOTES_DB_PATH=emotes/emotes.db

# ── Optional: server ──────────────────────────────────────────────────────────
VOXER_SERVER_HOST=127.0.0.1
VOXER_SERVER_PORT=8080
# Required for Docker or any non-localhost bind. Generate a separate secret:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Open /?token=YOUR_TOKEN (or /simple?token=YOUR_TOKEN) in the OBS browser source.
# The server exchanges the token for an HttpOnly cookie and strips it from the URL.
VOXER_OVERLAY_TOKEN=
# Additional exact hostnames/IP addresses used in OBS URLs, comma-separated.
# Loopback names and an explicit non-wildcard bind host are allowed by default.
# No URL schemes, paths, ports or wildcard hosts.
VOXER_ALLOWED_HOSTS=
# Only when using a TLS reverse proxy: its exact IP or narrow CIDR, never '*'.
# The proxy must overwrite X-Forwarded-For/Proto and forward Host unchanged.
VOXER_TRUSTED_PROXIES=
VOXER_MAX_WS_CLIENTS=8
VOXER_MAX_PENDING_PER_CLIENT=64
# Seconds one overlay client may take to accept a WebSocket message before the
# server drops it (default: 5).  An OBS browser source that is paused, or a
# laptop that went to sleep with the overlay open, keeps its connection but
# stops reading from it; without this deadline the bot waits on that one client
# and speaks nothing at all in the meantime.  Raise it only if you run the
# overlay over a slow or unreliable link.
VOXER_WS_SEND_TIMEOUT=5
# How the audio directory is kept tidy while the bot runs.  A clip is normally
# deleted the moment the overlay reports it finished playing, but a browser
# that crashes or is refreshed mid-clip never sends that report, so the file is
# left behind.  Every VOXER_AUDIO_SWEEP_INTERVAL_SECS seconds (default: 300) a
# background task deletes every MP3 in the directory that has not been written
# to for at least VOXER_AUDIO_MAX_AGE_SECS seconds (default: 300).
# Do not set the age low: a file younger than it may still be waiting for
# synthesis, on its way to the browser, or playing right now, and deleting one
# of those cuts the clip off mid-word.
VOXER_AUDIO_SWEEP_INTERVAL_SECS=300
VOXER_AUDIO_MAX_AGE_SECS=300

# ── Optional: scheduler ───────────────────────────────────────────────────────
# Seconds to wait before re-checking when the scheduled-message list is empty
# or invalid (default: 600).  This is NOT the posting cadence — that is derived
# from each message's frequency_per_hour in data/messages.json.
# (VOXER_SCHEDULER_INTERVAL is accepted as a deprecated alias.)
VOXER_SCHEDULER_EMPTY_RETRY_DELAY=600
# Seconds to wait before first scheduled message after startup (default: 10)
VOXER_SCHEDULER_INITIAL_DELAY=10

# ── Optional: TTS behaviour ───────────────────────────────────────────────────
# Comma-separated list of usernames that never receive the "X says:" prefix.
# Leave this commented out unless you need more than one name: it defaults to
# TWITCH_BOT_USERNAME, so the bot does not announce itself.  Setting it
# *replaces* that default rather than adding to it, so if you do set it,
# include the bot's own login in the list.
#VOXER_NO_ANNOUNCE_USERS=your_bot_account_login,another_bot

# Seconds of silence before re-announcing a user's name (default: 300 = 5 min)
VOXER_ANNOUNCE_WINDOW_SECS=300

# Comma-separated MP3 paths played for emote-only messages
VOXER_EMOTE_SOUND_PATHS=emotes/slack-message.mp3,emotes/discord.mp3

# How many messages may wait for speech synthesis at once (default: 20).
# Synthesis takes seconds per message, so without a limit a busy chat would
# push the overlay minutes behind live chat. When the queue is full, new chat
# messages are dropped; channel events (follows, subs, raids) are also dropped on overflow.
# Raise it to lose fewer messages during bursts, lower it to stay closer to live.
VOXER_MESSAGE_QUEUE_MAXSIZE=20
# Drop stale work rather than speak minutes behind live chat.
VOXER_MAX_MESSAGE_AGE_SECS=60
# Cap both incoming chat and text expanded by normalization/announcements.
VOXER_MAX_MESSAGE_CHARS=500
VOXER_MAX_SPEECH_CHARS=1000
# Minimum seconds between accepted messages from one chatter; 0 disables it.
VOXER_USER_COOLDOWN_SECS=2

# ── Optional: logging ─────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
VOXER_LOG_LEVEL=INFO
