# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
*.onnx.json
*.onnx
*.wav

.tio.tokens.json
data/audio/
audio/*.mp3
emotes/emotes.db
emotes/all_emotes.json

# Live OAuth credentials for the bot account. twitchio rewrites these roughly
# hourly, so without this rule a "git add -A" after any run publishes them.
data/tokens.json
data/tokens.tmp

# Coverage output
.coverage
htmlcov/

# Live runtime state, written by the bot while it runs: voices.json records
# which voice each viewer was assigned and timestamps.json when each of them
# last triggered an announcement.  Both contain real viewer logins from
# whatever channel the bot ran in, and both change on almost every message, so
# tracking them means committing other people's names and a permanent stream of
# diff noise.  The .example files beside them show the shape a fresh install
# starts from; the bot creates the real files itself on first run.
data/voices.json
data/timestamps.json
